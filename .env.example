# REI Reply / HighLevel
# Sub-account -> Settings -> Other Settings -> Private Integrations -> Create new Integration
# Scopes needed: contacts.write, contacts.readonly
REIREPLY_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
REIREPLY_LOCATION_ID=xxxxxxxxxxxxxxxxxxxx

# Safety: leave as 1 until you have eyeballed a few days of output.
# 1 = write everything to CSV and never call the REI Reply API.
DRY_RUN=1

# Cap on contacts pushed in a single run. Guards against a county
# schema change dumping 20k bogus leads into your CRM.
MAX_PUSH_PER_RUN=400

DB_PATH=./reileads.sqlite3
OUT_DIR=./out
